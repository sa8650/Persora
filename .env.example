# Local Vite preview uses the browser-only demo workspace; there is no local account service.
# Production custom authentication, database secrets, and the R2 binding belong in Cloudflare Pages settings.
VITE_USE_PAGES_FUNCTIONS=false

# Connections (EMS) — server-side ONLY. Set these as Cloudflare Pages secrets/variables, never as VITE_*.
# CONNECTIONS_ENCRYPTION_KEY=<openssl rand -hex 32>     # encrypts member grants + stored integration secret
# EMS_INTEGRATION_SECRET=<same ≥32-char secret as EMS>  # optional; overrides Admin → Integrations
# EMS_API_BASE_URL=https://ems.example.com              # optional; fallback EMS address (HTTPS)
